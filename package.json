{
  "name": "work-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Local knowledge debt console — verify claims, keep evidence pointers",
  "scripts": {
    "dev": "node --experimental-sqlite ./node_modules/next/dist/bin/next dev -p 3002",
    "build": "node --experimental-sqlite ./node_modules/next/dist/bin/next build",
    "start": "node --experimental-sqlite ./node_modules/next/dist/bin/next start -p 3002",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
